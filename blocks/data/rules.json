  "policies": [
    {
      "schemaName": "ReturnCase",
      "policyName": "customer-reads-own-returns",
      "policyDescription": "A customer may read only the ReturnCase rows they themselves created: role 'customer' AND CreatedBy equal to the caller's UserId claim. Keyed on CreatedBy, NOT customerItemId, because customerItemId is client-supplied and forgeable on insert (row-field rules are not evaluated on insert -- see ACCESS-NOTES.md section 11), while CreatedBy is stamped by the server from the auth context and is not even a field on ReturnCaseInsertInput. A forged row therefore carries the forger's id and is invisible to the customer it names. NOTE the consequence: a ReturnCase created by ops on a customer's behalf is NOT visible to that customer.",
      "policyType": 0,
      "operation": 0,
      "isAllowPolicy": true,
      "priority": 10,
      "fieldNames": [],
      "ruleGroup": {
        "logicalOperator": 0,
        "nestedGroups": [],
        "rules": [
          {
            "leftSource": 0,
            "leftOperand": "roles",
            "operator": 0,
            "rightSource": 2,
            "staticValue": "customer"
          },
          {
            "leftSource": 1,
            "leftOperand": "CreatedBy",
            "operator": 0,
            "rightSource": 0,
            "rightOperand": "UserId"
          }
        ]
      }
    },
    {
