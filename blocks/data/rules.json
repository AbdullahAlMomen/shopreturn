    {
      "schemaName": "ReturnCase",
      "policyName": "customer-creates-returns",
      "policyDescription": "A customer may create a ReturnCase row to start a return request. RULE 1 (roles == customer) IS ENFORCED. RULE 2 (customerItemId == UserId) IS NOT ENFORCED AND IS A NO-OP: row-field rules (leftSource 1) are not evaluated on insert -- proved by customer B successfully inserting a row with customerItemId omitted entirely while this rule was deployed. It is kept only as a declaration of intent in case the platform starts honouring it. Ownership on insert is therefore enforced ONLY by application code, which must set customerItemId from iam.me(); a hand-crafted API call can still forge it. See ACCESS-NOTES.md section 11.",
      "policyType": 0,
      "operation": 1,
      "isAllowPolicy": true,
      "priority": 20,
      "fieldNames": [],
      "ruleGroup": {
        "logicalOperator": 0,
        "nestedGroups": [],
        "rules": [
          {
            "leftSource": 0,
            "leftOperand": "roles",
            "operator": 0,
            "rightSource": 2,
            "staticValue": "customer"
          },
          {
            "leftSource": 1,
            "leftOperand": "customerItemId",
            "operator": 0,
            "rightSource": 0,
            "rightOperand": "UserId"
          }
        ]
      }
    },
